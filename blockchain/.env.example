# blockchain/.env.example
#
# Copy this file to ".env" (same folder) before running the faucet server.
# ".env" is git-ignored so this key never gets committed.
#
# This is Hardhat's default Account #0 test key — it is PUBLIC, documented,
# and identical on every machine running default Hardhat. It has zero real
# value and only works on your local throwaway chain. It is kept out of the
# script file (and out of the frontend) so it's obvious this is a
# local-only, swappable development secret, not something that ships
# anywhere.
FAUCET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Password for the "Admin" login on the landing page. Meets the same
# complexity rule as participant passwords (number, uppercase, lowercase,
# and @ or $). Change this before any real demo/presentation.
ADMIN_PASSWORD=Admin@2026

# The deployed SupplyChain contract address (must match
# frontend/src/contract.js's CONTRACT_ADDRESS exactly). Defaults to the
# deterministic address you get from a fresh `npx hardhat node` +
# `npx hardhat run scripts/deploy.js --network localhost`. Update this if
# your deployed address differs.
#
# IMPORTANT: if you're picking up the version of this project with the
# updated roles (Manufacturer/Transporter/Distributor/Pharmacy) and the
# rating feature, you MUST start from a completely fresh `npx hardhat
# node` and redeploy — old on-chain data (roles, batches) from a
# previous contract version is not compatible. Also delete/rename any
# existing blockchain/users.json first, since old accounts may have a
# role name ("Wholesaler"/"Consumer") that no longer exists.
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
